* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}


header {
  background-color: #000000; /* Preto */
  color: #C0C0C0; /* Prata */
  padding: 15px 20px;
  text-align: center;
  border-bottom: 3px solid #FF0000; /* Detalhe vermelho */
}

header nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
}

header nav ul li {
  margin: 0 15px;
}

header nav ul li a {
  color: #C0C0C0; /* Prata */
  text-decoration: none;
  font-size: 1.1rem;
  transition: color 0.3s;
}
header nav ul li a:hover {
  color: #FF0000; /* Vermelho */
}
 
header img{
    width: 10%;
    align-content: flex-start;
    display: flex;
    flex-wrap: wrap; 
    
}
.acss{
align-items: end;

}


body {
  background-color: #C0C0C0; /* Prata */
  color: #000000; /* Preto */
  line-height: 1.6;
}
main {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 20px;
  gap: 20px;
}

.card1a {
  background-color: #FFFFFF; /* Branco para contraste */
  border: 2px solid #FF0000; /* Vermelho */
  border-radius: 5px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
  text-align: center;
  padding: 15px;
  width: 250px;
  transition: transform 0.3s;
}

.card1a:hover {
  transform: scale(1.05);
}

.card1a img {
  width: 100%;
  border-bottom: 2px solid #FF0000;
  margin-bottom: 10px;
}

.card1a h2 {
  color: #000000; /* Preto */
  margin-bottom: 10px;
  font-size: 1.2rem;
}

.card1a p {
  color: #FF0000; /* Vermelho */
  font-weight: bold;
  margin-bottom: 15px;
}

/* ====== BOTÃO ====== */
.card1a button {
  background-color: #000000; /* Preto */
  color: #FFFFFF; /* Branco */
  border: 2px solid #FF0000; /* Vermelho */
  padding: 8px 12px;
  font-size: 1rem;
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s;
}

.card1a button:hover {
  background-color: #FF0000; /* Vermelho */
  color: #000000; /* Preto */
}

footer {
  background-color: #000000; /* Preto */
  color: #C0C0C0; /* Prata */
  text-align: center;
  padding: 10px;
  margin-top: 20px;
  border-top: 3px solid #FF0000; /* Detalhe vermelho */
}



 

  


